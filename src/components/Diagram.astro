---
interface Props {
	caption?: string;
	source?: string;
	sourceLabel?: string;
}

const { caption, source, sourceLabel = 'Source' } = Astro.props;
---

<figure class="diagram">
	<div class="diagram-frame">
		<slot />
	</div>
	{
		caption && (
			<figcaption>
				{caption}
				{source && (
					<>
						{' '}
						<a href={source} rel="noreferrer">
							{sourceLabel}
						</a>
					</>
				)}
			</figcaption>
		)
	}
</figure>

<style>
	.diagram {
		margin: 1.5rem 0;
	}

	.diagram-frame {
		display: flex;
		justify-content: center;
		overflow-x: auto;
	}

	.diagram-frame :global(svg) {
		max-width: 100%;
		height: auto;
	}

	figcaption {
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		text-align: center;
	}
</style>
