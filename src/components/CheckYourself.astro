---
interface Option {
	label: string;
	feedback: string;
	correct?: boolean;
}

interface Props {
	question: string;
	options: Option[];
}

const { question, options } = Astro.props;
---

<fieldset class="quiz" data-quiz>
	<legend class="question">{question}</legend>
	<div class="options">
		{
			options.map((option) => (
				<button type="button" class="option" data-option data-correct={option.correct ? 'true' : 'false'} data-feedback={option.feedback}>
					{option.label}
				</button>
			))
		}
	</div>
	<p class="feedback" data-feedback role="status"></p>
</fieldset>

<style>
	.quiz {
		display: grid;
		gap: 0.75rem;
		margin: 2rem 0;
		padding: 1.25rem;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.75rem;
		background: var(--sl-color-gray-6);
	}

	.question {
		padding: 0;
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--sl-color-gray-1);
	}

	.options {
		display: grid;
		gap: 0.5rem;
	}

	.option {
		padding: 0.55rem 0.75rem;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.375rem;
		background: transparent;
		color: var(--sl-color-gray-2);
		font: inherit;
		font-size: 0.875rem;
		text-align: left;
		cursor: pointer;
	}

	.option:hover {
		background: var(--sl-color-gray-5);
	}

	.option:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	.option[data-state='correct'] {
		border-color: var(--sl-color-green);
		color: var(--sl-color-green-high);
		background: var(--sl-color-green-low);
	}

	.option[data-state='wrong'] {
		border-color: var(--sl-color-red);
		color: var(--sl-color-red-high);
		background: var(--sl-color-red-low);
	}

	.feedback {
		margin: 0;
		min-height: 1.25rem;
		font-size: 0.875rem;
		color: var(--sl-color-gray-2);
	}
</style>

<script>
	document.querySelectorAll<HTMLFieldSetElement>('[data-quiz]').forEach((quiz) => {
		const options = [...quiz.querySelectorAll<HTMLButtonElement>('[data-option]')];
		const feedback = quiz.querySelector<HTMLElement>('[data-feedback]');
		if (!feedback) return;

		for (const option of options) {
			option.addEventListener('click', () => {
				const correct = option.dataset.correct === 'true';
				for (const other of options) other.removeAttribute('data-state');
				option.dataset.state = correct ? 'correct' : 'wrong';
				if (!correct) {
					const answer = options.find((other) => other.dataset.correct === 'true');
					if (answer) answer.dataset.state = 'correct';
				}
				feedback.textContent = option.dataset.feedback ?? '';
			});
		}
	});
</script>
