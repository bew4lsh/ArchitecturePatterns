---
const label = 'Hide the sidebar';
---

<button type="button" class="sidebar-toggle" data-sidebar-toggle aria-controls="starlight__sidebar" aria-expanded="true">
	<span class="sr-only">{label}</span>
	<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
		<rect x="3" y="4.5" width="18" height="15" rx="2.5" />
		<path d="M9.5 4.5v15" />
		<path class="when-shown" d="M16 9.5 13.5 12l2.5 2.5" />
		<path class="when-hidden" d="M13.5 9.5 16 12l-2.5 2.5" />
	</svg>
</button>

<script is:inline>
	(() => {
		const STORAGE_KEY = 'starlight-sidebar';
		const BOUND_FLAG = 'sidebarToggleBound';
		const root = document.documentElement;

		// Starlight renders some components in more than one place, so a second copy of this
		// script is possible. Two listeners would toggle the sidebar twice and cancel out.
		if (root.dataset[BOUND_FLAG]) return;
		root.dataset[BOUND_FLAG] = 'true';

		const toggles = () => document.querySelectorAll('[data-sidebar-toggle]');

		const read = () => {
			try {
				return localStorage.getItem(STORAGE_KEY) === 'hidden';
			} catch {
				return false;
			}
		};

		const write = (hidden) => {
			try {
				if (hidden) localStorage.setItem(STORAGE_KEY, 'hidden');
				else localStorage.removeItem(STORAGE_KEY);
			} catch {
				return;
			}
		};

		const apply = (hidden) => {
			if (hidden) root.dataset.sidebar = 'hidden';
			else delete root.dataset.sidebar;
			toggles().forEach((toggle) => {
				toggle.setAttribute('aria-expanded', hidden ? 'false' : 'true');
				const label = toggle.querySelector('.sr-only');
				if (label) label.textContent = hidden ? 'Show the sidebar' : 'Hide the sidebar';
			});
		};

		apply(read());

		document.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof Element) || !target.closest('[data-sidebar-toggle]')) return;
			const hidden = root.dataset.sidebar !== 'hidden';
			apply(hidden);
			write(hidden);
		});
	})();
</script>

<style>
	.sidebar-toggle {
		display: flex;
		align-items: center;
		padding: 0.4em;
		border: 0;
		background: none;
		color: var(--sl-color-gray-3);
		cursor: pointer;
	}

	.sidebar-toggle:hover {
		color: var(--sl-color-white);
	}

	.sidebar-toggle:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	.when-hidden {
		display: none;
	}

	:global(html[data-sidebar='hidden']) .when-shown {
		display: none;
	}

	:global(html[data-sidebar='hidden']) .when-hidden {
		display: block;
	}

	/* Below this width Starlight turns the sidebar into a popover with its own menu button,
	   and the layout rules below do not apply. */
	@media screen and (width < 50em) {
		.sidebar-toggle {
			display: none;
		}
	}

	/* Nothing to collapse on a page that has no sidebar, such as the splash page. */
	:global(html:not([data-has-sidebar])) .sidebar-toggle {
		display: none;
	}

	@media screen and (min-width: 50em) {
		/* The sidebar is a fixed pane, and the space it occupies is a padding on the main frame
		   driven by this one variable. Zeroing it hands the column back to the page.
		   `--sl-sidebar-width` stays at its real value: the table of contents sizes its column
		   and its own inner container from it, and a zero there leaves the contents collapsed
		   to a sliver of stacked letters. The reading measure widens, since the sidebar is no
		   longer taking a share of the screen. */
		:global(html[data-sidebar='hidden'][data-has-sidebar]) {
			--sl-content-inline-start: 0px;
			--sl-content-width: 50rem;
		}

		:global(html[data-sidebar='hidden'] .sidebar-pane) {
			display: none;
		}

		/* With the sidebar gone the text column is centred in the space that is left instead of
		   being pushed against the table of contents. */
		:global(html[data-sidebar='hidden'][data-has-sidebar][data-has-toc] .main-pane) {
			--sl-content-margin-inline: auto;
		}
	}
</style>
