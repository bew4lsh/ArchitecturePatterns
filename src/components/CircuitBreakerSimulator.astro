---
interface Props {
	/** Probability a call to the dependency fails, in percent. */
	failureRate?: number;
	/** Consecutive failures that trip the breaker. */
	threshold?: number;
	/** Seconds the breaker stays open before probing. */
	cooldown?: number;
}

const { failureRate = 70, threshold = 3, cooldown = 5 } = Astro.props;

const CELL_COUNT = 32;
const cells = Array.from({ length: CELL_COUNT });
---

<section class="sim not-content" data-sim data-state="closed" aria-label="Circuit breaker simulator">
	<div class="controls">
		<label class="control">
			<span>Dependency fails <b data-failure-value>{failureRate}</b>% of calls</span>
			<input type="range" data-failure min="0" max="100" step="5" value={failureRate} />
		</label>
		<label class="control">
			<span>Trip after <b data-threshold-value>{threshold}</b> failures in a row</span>
			<input type="range" data-threshold min="1" max="8" step="1" value={threshold} />
		</label>
		<label class="control">
			<span>Cooldown <b data-cooldown-value>{cooldown}</b> seconds</span>
			<input type="range" data-cooldown min="2" max="15" step="1" value={cooldown} />
		</label>
		<div class="buttons">
			<button type="button" data-toggle>Pause</button>
			<button type="button" data-reset>Reset</button>
		</div>
	</div>

	<div class="state">
		<span class="badge" data-badge>CLOSED</span>
		<p class="verdict" data-verdict aria-live="polite">
			Calls pass through and the breaker counts failures.
		</p>
	</div>

	<figure class="timeline">
		<div class="cells" data-cells aria-hidden="true">
			{cells.map(() => <span class="cell" data-cell />)}
		</div>
		<figcaption>
			<span>One cell per request, oldest on the left</span>
			<span class="legend">
				<span class="key" data-key="success">succeeded</span>
				<span class="key" data-key="failure">failed</span>
				<span class="key" data-key="rejected">rejected, never sent</span>
			</span>
		</figcaption>
	</figure>

	<div class="readout">
		<div class="meter">
			<span class="meter-label">Failures in a row</span>
			<div class="meter-track" aria-hidden="true">
				<span class="meter-fill" data-meter />
			</div>
			<span class="meter-count" data-count>0 / {threshold}</span>
		</div>
		<p class="note" data-note>Calls sent to the dependency: 0 · rejected by the breaker: 0</p>
	</div>
</section>

<style>
	.sim {
		--sim-state: var(--sl-color-green);
		display: grid;
		gap: 1rem;
		margin: 2rem 0;
		padding: 1.25rem;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.75rem;
		background: var(--sl-color-gray-6);
	}

	.sim[data-state='open'] {
		--sim-state: var(--sl-color-red);
	}

	.sim[data-state='half-open'] {
		--sim-state: var(--sl-color-orange);
	}

	.controls {
		display: flex;
		flex-wrap: wrap;
		align-items: end;
		gap: 0.75rem 1.5rem;
	}

	.control {
		display: grid;
		flex: 1 1 12rem;
		gap: 0.35rem;
		font-size: 0.8125rem;
		color: var(--sl-color-gray-2);
	}

	.control b {
		font-variant-numeric: tabular-nums;
	}

	.control input {
		width: 100%;
		accent-color: var(--sl-color-accent);
	}

	.buttons {
		display: flex;
		gap: 0.5rem;
	}

	.buttons button {
		padding: 0.35rem 0.75rem;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.375rem;
		background: transparent;
		color: var(--sl-color-gray-2);
		font: inherit;
		font-size: 0.8125rem;
		cursor: pointer;
	}

	.buttons button:hover {
		background: var(--sl-color-gray-5);
	}

	.state {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.3rem 0.7rem;
		border: 2px solid var(--sim-state);
		border-radius: 999px;
		color: var(--sim-state);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.sim[data-state='half-open'] .badge {
		border-style: dashed;
	}

	.badge::before {
		content: '';
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--sim-state);
	}

	.verdict {
		flex: 1 1 20rem;
		margin: 0;
		font-size: 0.9375rem;
		color: var(--sl-color-gray-1);
	}

	.timeline {
		margin: 0;
	}

	.cells {
		display: flex;
		gap: 2px;
		height: 1.4rem;
	}

	.cell {
		flex: 1;
		min-width: 0;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 2px;
	}

	.cell[data-kind='success'] {
		border-color: var(--sl-color-green);
		background: var(--sl-color-green);
	}

	.cell[data-kind='failure'] {
		border-color: var(--sl-color-red);
		background: var(--sl-color-red);
	}

	.cell[data-kind='rejected'] {
		border-style: dashed;
		background: repeating-linear-gradient(135deg, transparent 0 2px, var(--sl-color-gray-4) 2px 3px);
	}

	.timeline figcaption {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.35rem 1rem;
		margin-top: 0.4rem;
		font-size: 0.75rem;
		color: var(--sl-color-gray-3);
	}

	.legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.9rem;
	}

	.key::before {
		content: '';
		display: inline-block;
		width: 0.6rem;
		height: 0.6rem;
		margin-right: 0.35rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 2px;
		vertical-align: -0.05rem;
	}

	.key[data-key='success']::before {
		border-color: var(--sl-color-green);
		background: var(--sl-color-green);
	}

	.key[data-key='failure']::before {
		border-color: var(--sl-color-red);
		background: var(--sl-color-red);
	}

	.key[data-key='rejected']::before {
		border-style: dashed;
		background: repeating-linear-gradient(135deg, transparent 0 2px, var(--sl-color-gray-4) 2px 3px);
	}

	.readout {
		display: grid;
		gap: 0.5rem;
	}

	.meter {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.75rem;
		color: var(--sl-color-gray-3);
	}

	.meter-label {
		flex: 0 0 auto;
	}

	.meter-track {
		flex: 1;
		height: 0.5rem;
		border-radius: 999px;
		background: var(--sl-color-gray-5);
		overflow: hidden;
	}

	.meter-fill {
		display: block;
		width: 0%;
		height: 100%;
		border-radius: inherit;
		background: var(--sl-color-red);
		transition: width 120ms linear;
	}

	.meter-count,
	.note {
		font-variant-numeric: tabular-nums;
	}

	.meter-count {
		flex: 0 0 auto;
		color: var(--sl-color-gray-2);
	}

	.note {
		margin: 0;
		font-size: 0.75rem;
		color: var(--sl-color-gray-3);
	}
</style>

<script>
	const TICK_MS = 700;
	const CELL_COUNT = 32;

	type State = 'closed' | 'open' | 'half-open';
	type Outcome = 'success' | 'failure' | 'rejected';

	function init(root: HTMLElement) {
		const failureInput = root.querySelector<HTMLInputElement>('[data-failure]')!;
		const thresholdInput = root.querySelector<HTMLInputElement>('[data-threshold]')!;
		const cooldownInput = root.querySelector<HTMLInputElement>('[data-cooldown]')!;
		const failureValue = root.querySelector('[data-failure-value]')!;
		const thresholdValue = root.querySelector('[data-threshold-value]')!;
		const cooldownValue = root.querySelector('[data-cooldown-value]')!;
		const badge = root.querySelector('[data-badge]')!;
		const verdict = root.querySelector('[data-verdict]')!;
		const note = root.querySelector('[data-note]')!;
		const meter = root.querySelector<HTMLElement>('[data-meter]')!;
		const count = root.querySelector('[data-count]')!;
		const cells = root.querySelectorAll<HTMLElement>('[data-cell]');
		const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
		const reset = root.querySelector<HTMLButtonElement>('[data-reset]')!;

		let state: State = 'closed';
		let failures = 0;
		let openedAt = 0;
		let openUntil = 0;
		let sent = 0;
		let rejected = 0;
		let history: Outcome[] = [];
		let timer = 0;
		let running = true;

		const threshold = () => Number(thresholdInput.value);
		const cooldown = () => Number(cooldownInput.value);
		const failureRate = () => Number(failureInput.value);
		const remaining = () => Math.max(0, Math.ceil((openUntil - Date.now()) / 1000));

		const describe = () => {
			if (state === 'open') {
				return `Open: calls fail immediately and the dependency gets no traffic. Probing in ${remaining()}s.`;
			}
			if (state === 'half-open') {
				return 'Half-open: one probe is allowed through. Success closes the breaker, failure reopens it.';
			}
			if (failures === 0) {
				return `Closed: calls pass through. Trips after ${threshold()} failures in a row.`;
			}
			return `Closed: ${failures} failure${failures === 1 ? '' : 's'} in a row. Trips at ${threshold()}.`;
		};

		const render = () => {
			root.dataset.state = state;
			badge.textContent = state === 'half-open' ? 'HALF-OPEN' : state.toUpperCase();
			verdict.textContent = describe();
			failureValue.textContent = String(failureRate());
			thresholdValue.textContent = String(threshold());
			cooldownValue.textContent = String(cooldown());

			const span = threshold();
			meter.style.width = `${Math.min(100, (failures / span) * 100)}%`;
			count.textContent = `${failures} / ${span}`;

			const trailing = history.slice(-CELL_COUNT);
			const offset = CELL_COUNT - trailing.length;
			cells.forEach((cell, index) => {
				const outcome = index >= offset ? trailing[index - offset] : undefined;
				if (outcome) cell.dataset.kind = outcome;
				else cell.removeAttribute('data-kind');
			});

			note.textContent = `Calls sent to the dependency: ${sent} · rejected by the breaker: ${rejected}`;
		};

		const tick = () => {
			const now = Date.now();

			if (state === 'open' && now >= openUntil) {
				state = 'half-open';
			}

			if (state === 'open') {
				rejected += 1;
				history.push('rejected');
			} else {
				const failed = Math.random() * 100 < failureRate();
				sent += 1;
				if (failed) {
					history.push('failure');
					if (state === 'half-open') {
						failures = threshold();
						state = 'open';
						openedAt = now;
						openUntil = now + cooldown() * 1000;
					} else {
						failures += 1;
						if (failures >= threshold()) {
							failures = threshold();
							state = 'open';
							openedAt = now;
							openUntil = now + cooldown() * 1000;
						}
					}
				} else {
					history.push('success');
					failures = 0;
					if (state === 'half-open') state = 'closed';
				}
			}

			if (history.length > CELL_COUNT) history = history.slice(-CELL_COUNT);
			render();
		};

		const start = () => {
			if (timer) return;
			timer = window.setInterval(tick, TICK_MS);
		};

		const stop = () => {
			window.clearInterval(timer);
			timer = 0;
		};

		failureInput.addEventListener('input', render);
		thresholdInput.addEventListener('input', render);
		cooldownInput.addEventListener('input', () => {
			if (state === 'open') openUntil = openedAt + cooldown() * 1000;
			render();
		});

		toggle.addEventListener('click', () => {
			running = !running;
			toggle.textContent = running ? 'Pause' : 'Resume';
			if (running) start();
			else stop();
		});

		reset.addEventListener('click', () => {
			state = 'closed';
			failures = 0;
			openedAt = 0;
			openUntil = 0;
			sent = 0;
			rejected = 0;
			history = [];
			render();
		});

		render();

		new IntersectionObserver(
			(entries) => {
				if (entries.some((entry) => entry.isIntersecting)) {
					if (running) start();
				} else {
					stop();
				}
			},
			{ threshold: 0.1 }
		).observe(root);

		document.addEventListener('visibilitychange', () => {
			if (document.hidden) stop();
			else if (running) start();
		});
	}

	document.querySelectorAll<HTMLElement>('[data-sim]').forEach(init);
</script>
